<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Authors>Vippy</Authors>
    <!-- Fourth component = tester iteration. BepInEx rejects SemVer pre-release tags. -->
    <Version>1.6.0.2</Version>
    <TesterManagedDir>D:\SteamLibrary\steamapps\common\REPO\REPO_Data\Managed</TesterManagedDir>
    <OutputPath>C:\Users\wells\AppData\Roaming\com.kesomannen.gale\repo\profiles\Development-Tester\BepInEx\plugins\REPOFidelity\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\prebuild.ps1&quot; -Version $(Version)" />
  </Target>

  <Target Name="CopyShaderBundle" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\repofidelity_shaders"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\repofidelity_shaders')" />
  </Target>

  <!-- PackageMod target disabled on tester-update branch: no public release zip. -->
  <Target Name="PackageMod" AfterTargets="CopyShaderBundle">
    <Message Text="[tester-update] Skipping Thunderstore packaging for $(Version)" Importance="high" />
  </Target>

  <ItemGroup>
    <Compile Remove="UnityShaderProject\**" />
    <None Remove="UnityShaderProject\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="UnityEngine.NVIDIAModule" />
  </ItemGroup>

  <!-- Tester direct-DLL references (not on NuGet; offline only) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(TesterManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(TesterManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(TesterManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(TesterManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(TesterManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(TesterManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(TesterManagedDir)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(TesterManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MenuLib">
      <HintPath>$(OutputPath)\..\nickklmao-MenuLib\MenuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
